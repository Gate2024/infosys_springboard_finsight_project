DB_HOST=localhost
DB_NAME=Finsight
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432
SECRET_KEY=your_secret_key_here
FLASK_DEBUG=false
# Optional PostgreSQL TLS settings; production defaults to sslmode=require.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/ca-certificate.crt

# SMTP settings required for registration verification and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# Optional session overrides; production should use SESSION_COOKIE_SECURE=true.
# SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
# REMEMBER_ME_TIMEOUT_SECONDS=2592000
# SESSION_COOKIE_SECURE=false
